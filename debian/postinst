#!/bin/sh
# 仅配置系统权限；不以 root 身份下载 Python 包，不自动启动录音服务。
set -e
case "${1:-}" in
    configure)
        groupadd -f input
        USER_NAME="${SUDO_USER:-}"
        if [ -n "$USER_NAME" ] && [ "$USER_NAME" != root ]; then
            usermod -aG input "$USER_NAME"
        fi
        if command -v modprobe >/dev/null 2>&1; then
            modprobe uinput || true
        fi
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
            udevadm trigger --subsystem-match=misc --sysname-match=uinput || true
        fi
        cat <<'HELP'
豆包轻量版已安装；不会自动弹窗或启动录音。
Python 和程序依赖已包含，无需安装 uv/pip 或创建虚拟环境。
网页登录需要已安装原生 Chrome/Chromium。
如果安装时无法确定普通用户，请手动 sudo usermod -aG input <用户名>。
注销并重新登录后：
  /usr/bin/doubao-input login
需要自启时，在桌面终端运行：
  systemctl --user daemon-reload
  systemctl --user enable --now doubao-input.service
如之前手动安装过，请检查 ~/.config/systemd/user/doubao-input.service
是否仍指向旧二进制；deb 提供的服务使用 /usr/bin/doubao-input。
HELP
        ;;
esac
#DEBHELPER#
exit 0
