#!/bin/sh
# 仅配置系统权限；不以 root 身份下载 Python 包，不自动启动录音服务。
set -e
case "${1:-}" in
    configure)
        groupadd -f input
        USER_NAME="${SUDO_USER:-}"
        if [ -n "$USER_NAME" ] && [ "$USER_NAME" != root ]; then
            usermod -aG input "$USER_NAME"
        fi
        if command -v modprobe >/dev/null 2>&1; then
            modprobe uinput || true
        fi
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
            udevadm trigger --subsystem-match=misc --sysname-match=uinput || true
        fi
        cat <<'HELP'
豆包轻量版已安装；不会自动弹窗或启动录音。
请以普通用户在桌面终端使用 uv 初始化环境：
  uv venv --python /usr/bin/python3 --system-site-packages ~/.local/share/doubao-input/.venv
  uv pip install --python ~/.local/share/doubao-input/.venv/bin/python -r /usr/share/doc/doubao-input/requirements.txt
如果安装时无法确定普通用户，请手动 sudo usermod -aG input <用户名>。
注销并重新登录后：
  doubao-input login
  doubao-input doctor
  doubao-input serve
需要自启时，在桌面终端运行：
  systemctl --user import-environment DISPLAY XAUTHORITY WAYLAND_DISPLAY
  systemctl --user daemon-reload
  systemctl --user enable --now doubao-input.service
HELP
        ;;
esac
#DEBHELPER#
exit 0
